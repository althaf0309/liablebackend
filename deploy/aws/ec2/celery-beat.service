[Unit]
Description=Liable Celery Beat Scheduler
After=network.target redis.service celery-worker.service
Requires=redis.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/liablewebsite
Environment="PATH=/home/ubuntu/liablewebsite/env/bin"
ExecStart=/home/ubuntu/liablewebsite/env/bin/celery \
    -A liablewebsite beat \
    --loglevel=info \
    --scheduler django_celery_beat.schedulers:DatabaseScheduler \
    --logfile=/var/log/liable/celery-beat.log
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
