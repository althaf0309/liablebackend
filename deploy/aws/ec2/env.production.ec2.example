DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-strong-secret
DJANGO_ALLOWED_HOSTS=api.lgsltd.uk,18.175.117.58,localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=https://lgsltd.uk,https://www.lgsltd.uk,https://app.lgsltd.uk
CSRF_TRUSTED_ORIGINS=https://lgsltd.uk,https://www.lgsltd.uk,https://app.lgsltd.uk,https://api.lgsltd.uk
FRONTEND_BASE_URL=https://lgsltd.uk

DATABASE_URL=postgres://liable_user:replace-password@rds-endpoint.eu-west-2.rds.amazonaws.com:5432/liable
DB_CONN_MAX_AGE=60

DJANGO_STATIC_ROOT=/var/www/liablebackend/staticfiles
PRIVATE_MEDIA_ROOT=/var/www/liablebackend/private_media

USE_S3_PRIVATE_STORAGE=true
AWS_STORAGE_BUCKET_NAME=liable-private-documents
AWS_S3_REGION_NAME=eu-west-2
AWS_PRIVATE_MEDIA_LOCATION=private-media
AWS_S3_SERVER_SIDE_ENCRYPTION=AES256

SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=None
CSRF_COOKIE_SAMESITE=None
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# ── Redis + Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# ── Backups ───────────────────────────────────────────────────────────────────
# BACKUP_S3_BUCKET defaults to AWS_STORAGE_BUCKET_NAME if not set
BACKUP_S3_BUCKET=liable-backups
BACKUP_S3_PREFIX=db-backups
BACKUP_LAST_SUCCESS_AT=

# ── Monitoring ────────────────────────────────────────────────────────────────
MALWARE_SCAN_REQUIRED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
DJANGO_LOG_LEVEL=INFO

OPENAI_API_KEY=
OPENAI_SUPPORT_MODEL=gpt-5-mini
OPENAI_TIMEOUT=20

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=info@lgsltd.uk
EMAIL_HOST_PASSWORD=replace-with-mail-secret
DEFAULT_FROM_EMAIL=info@lgsltd.uk
SERVER_EMAIL=info@lgsltd.uk
CONTACT_ADMIN_EMAILS=info@lgsltd.uk
MAIL_BRAND_NAME=Liable
