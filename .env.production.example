DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=api.lgsltd.uk,localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=https://lgsltd.uk,https://www.lgsltd.uk,https://app.lgsltd.uk
CSRF_TRUSTED_ORIGINS=https://lgsltd.uk,https://www.lgsltd.uk,https://app.lgsltd.uk,https://api.lgsltd.uk
FRONTEND_BASE_URL=https://lgsltd.uk

SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
SECURE_REFERRER_POLICY=same-origin

DRF_THROTTLE_ANON=100/hour
DRF_THROTTLE_USER=1000/hour
DRF_THROTTLE_LOGIN=10/hour
DRF_THROTTLE_PASSWORD_RESET_REQUEST=5/hour
DRF_THROTTLE_PASSWORD_RESET_VERIFY=10/hour
DRF_THROTTLE_PUBLIC_REGISTRATION=10/hour
DRF_THROTTLE_CONTACT_CREATE=5/hour

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=info@lgsltd.uk
EMAIL_HOST_PASSWORD=replace-with-mail-secret
DEFAULT_FROM_EMAIL=info@lgsltd.uk
SERVER_EMAIL=info@lgsltd.uk
CONTACT_ADMIN_EMAILS=info@lgsltd.uk
MAIL_BRAND_NAME=Liable

DATABASE_URL=postgres://liable_user:replace-password@db-host.example.com:5432/liable
DB_CONN_MAX_AGE=60
DJANGO_STATIC_ROOT=/var/app/staticfiles
PRIVATE_MEDIA_ROOT=/var/private/liable-media
USE_S3_PRIVATE_STORAGE=true
AWS_STORAGE_BUCKET_NAME=liable-private-documents
AWS_S3_REGION_NAME=eu-west-2
AWS_PRIVATE_MEDIA_LOCATION=private-media
AWS_S3_SERVER_SIDE_ENCRYPTION=AES256
MALWARE_SCAN_REQUIRED=true
MALWARE_SCAN_COMMAND=clamscan --no-summary
MALWARE_SCAN_TIMEOUT=30
OBJECT_STORAGE_PRIVATE_BUCKET=liable-private-documents
OBJECT_STORAGE_REGION=eu-west-2
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
DJANGO_LOG_LEVEL=INFO

OPENAI_API_KEY=
OPENAI_SUPPORT_MODEL=gpt-5-mini
OPENAI_TIMEOUT=20
